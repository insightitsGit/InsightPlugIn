{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run InsightPlugIn Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "compile",
      "sourceMaps": true
    }
  ]
}
